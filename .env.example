# =============================================================================
# Environment Configuration Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (or .env.local):
#      cp .env.example .env
#
# 2. Fill in the values below for your local setup.
#
# SECURITY NOTE:
# - .env / .env.local are gitignored and will NOT be committed
# - Never commit actual secrets or API keys to git
# - For CI/CD, use repository secrets instead
# =============================================================================

# Backend
# PORT=8000
# DATABASE_URL=

# Auth (fill in when auth is added)
# JWT_SECRET=

# Third-party API keys (fill in as needed)
# OPENAI_API_KEY=

# YouTube Data API v3 key (free tier, no OAuth needed for public search/
# channel reads). Get one via Google Cloud Console: create a project,
# enable "YouTube Data API v3", then Credentials -> Create Credentials ->
# API Key. Without this set, backend/app/ingestion/youtube.py's ingestion
# loop never starts -- no fake data, it just doesn't run.
# YOUTUBE_API_KEY=

# Optional: override the default 2-hour YouTube ingestion poll interval.
# YOUTUBE_INGEST_INTERVAL_SECONDS=
